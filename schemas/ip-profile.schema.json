{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wukongai/custom-ip-illustration-skill/blob/main/schemas/ip-profile.schema.json",
  "title": "IP Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "ownership",
    "identity",
    "appearance",
    "personality",
    "continuity_anchors"
  ],
  "properties": {
    "schema": {
      "const": "ip-profile/v1"
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "basis"
      ],
      "properties": {
        "status": {
          "enum": [
            "user_owned",
            "licensed",
            "authorized"
          ]
        },
        "basis": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "appearance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "signature_features"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "signature_features": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "personality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "traits"
      ],
      "properties": {
        "traits": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "continuity_anchors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "references": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "purpose",
          "authorized"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "enum": [
              "identity",
              "appearance",
              "style",
              "composition"
            ]
          },
          "authorized": {
            "const": true
          }
        }
      }
    }
  }
}
