{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wukongai/custom-ip-illustration-skill/blob/main/schemas/render-request.schema.json",
  "title": "Provider-neutral Render Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "title",
    "template_id",
    "images"
  ],
  "properties": {
    "schema": {
      "const": "render-request/v1"
    },
    "title": {
      "type": "string"
    },
    "template_id": {
      "type": "string"
    },
    "images": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "prompt_path",
          "output_path",
          "canvas",
          "width",
          "height",
          "reference_images"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "prompt_path": {
            "type": "string"
          },
          "output_path": {
            "type": "string"
          },
          "canvas": {
            "enum": [
              "16:9",
              "1:1",
              "9:16"
            ]
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "reference_images": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
