{
  "schema_version": "ip-editorial-baseline/v1",
  "id": "editorial-baseline-v1",
  "scope": "identity-neutral",
  "background": "pure white",
  "line_language": "controlled hand-drawn editorial contours",
  "shading": "flat color with two or three restrained illustrated value steps",
  "information_colors": {
    "primary_action": "#E8752B",
